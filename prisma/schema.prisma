generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  TEACHER
  STUDENT
}

enum Difficulty {
  EASY
  MEDIUM
  HARD
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String?
  passwordHash String?
  role         Role     @default(STUDENT)
  createdAt    DateTime @default(now())
}

model Question {
  id          String     @id @default(cuid())
  subject     String
  category    String
  topic       String
  difficulty  Difficulty
  lang        String
  text        String
  options     Json
  correct     String
  explanation String
  approved    Boolean    @default(false)
  source      String     @default("AI")
  createdAt   DateTime   @default(now())
}

model Resource {
  id        String   @id @default(cuid())
  title     String
  category  String
  fileUrl   String
  priceBdt  Int      @default(0)
  downloads Int      @default(0)
  createdAt DateTime @default(now())
}

model Notice {
  id        String   @id @default(cuid())
  text      String
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
}

model Job {
  id       String    @id @default(cuid())
  title    String
  type     String
  org      String
  deadline DateTime?
  url      String?
}

model Inquiry {
  id        String   @id @default(cuid())
  name      String
  email     String
  budget    String?
  message   String
  createdAt DateTime @default(now())
}

model ModelTest {
  id          String    @id @default(cuid())
  title       String
  minutes     Int
  questionIds Json
  createdAt   DateTime  @default(now())
  attempts    Attempt[]
}

model Attempt {
  id        String    @id @default(cuid())
  testId    String
  test      ModelTest @relation(fields: [testId], references: [id])
  userId    String
  userName  String
  score     Int
  total     Int
  createdAt DateTime  @default(now())
}

model Post {
  id              String    @id @default(cuid())
  title           String
  body            String
  slug            String?   @unique
  metaTitle       String?
  metaDescription String?
  coverUrl        String?
  coverAlt        String?
  downloadUrl     String?
  categoryId      String?
  chapter         String?
  tags            String[]  @default([])
  published       Boolean   @default(true)
  category        Category? @relation(fields: [categoryId], references: [id])
  createdAt       DateTime  @default(now())
  excerpt         String?
  focusKeyword    String?
  keywords        String[]  @default([])
}

model Category {
  id        String     @id @default(cuid())
  name      String
  slug      String     @unique
  parentId  String?
  parent    Category?  @relation("CategoryTree", fields: [parentId], references: [id])
  children  Category[] @relation("CategoryTree")
  posts     Post[]
  createdAt DateTime   @default(now())
}

model Testimonial {
  id        String   @id @default(cuid())
  name      String
  role      String?
  quote     String
  createdAt DateTime @default(now())
}

model Purchase {
  id         String   @id
  userId     String
  resourceId String
  amount     Int
  status     String   @default("PENDING")
  createdAt  DateTime @default(now())
}
model Setting {
  key   String @id
  value String
}

model Page {
  id        String   @id @default(cuid())
  slug      String   @unique
  title     String
  body      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
model TeacherProfile {
  id          String   @id @default(cuid())
  userId      String   @unique
  institution String
  division    String
  district    String
  upazila     String
  phone       String?
  address     String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}
model AiTask {
  id         String   @id @default(cuid())
  prompt     String
  type       String   @default("BLOG") 
  category   String?  
  subject    String?  
  topic      String?  
  status     String   @default("PENDING")
  part       Int      @default(1)   // 🎯 নতুন: কাজের পার্ট নাম্বার
  totalParts Int      @default(1)   // 🎯 নতুন: মোট কত পার্ট
  batchId    String?                // 🎯 নতুন: একই আর্টিকেলের কাজগুলো চেনার জন্য
  postId     String?                // 🎯 নতুন: ব্লগ তৈরি হলে তার আইডি সেভ হবে
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}
